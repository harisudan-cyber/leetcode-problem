class Solution {
    public boolean isValid(String s) {
        int n=s.length();
        if(n%2==1) return false;
        Stack<Character> st=new Stack<>();
        for(int i=0;i<n;i++){
            if(s.charAt(i)=='{'||s.charAt(i)=='('||s.charAt(i)=='['){
                st.add(s.charAt(i));
            }
            else {
            if(!st.isEmpty()&&((st.peek()=='{' && s.charAt(i)=='}')||(st.peek()=='(' && s.charAt(i)==')')||(st.peek()=='['&&s.charAt(i)==']'))){
                    st.pop();
            } 
            else{
                return false;
            }
            } 
        }
        return st.isEmpty();
    }
}

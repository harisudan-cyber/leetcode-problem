class MedianFinder {
PriorityQueue<Integer> lt,rt;
    public MedianFinder() {
        lt=new PriorityQueue<>(Collections.reverseOrder());
        rt=new PriorityQueue<>();
    }
    
    public void addNum(int num) {
        lt.add(num);
        rt.add(lt.poll());
        if(lt.size()<rt.size())
        lt.add(rt.poll());
    }
    
    public double findMedian() {
        if(lt.size()==rt.size())
        return (lt.peek()+rt.peek())/2.0;
        return lt.peek();
    }
}


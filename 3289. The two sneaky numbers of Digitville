class Solution {
    public int[] getSneakyNumbers(int[] nums) {
        int n=nums.length;
        int k=0;
        int[] nums2=new int[2];
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if(nums[i]==nums[j]){
                    nums2[k++]=nums[i];
                    break;
                }
            }
        }
        return nums2;
    }
}
